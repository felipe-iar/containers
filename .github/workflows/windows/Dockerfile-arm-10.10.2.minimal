# escape=`

ARG WINVER=2025

# Use a recent Server Core LTSC image
FROM mcr.microsoft.com/windows/servercore:ltsc${WINVER} as build

ARG VERSION=10.10.2

LABEL org.opencontainers.image.description="IAR Build Tools for Arm (CX)"
LABEL org.opencontainers.image.ref_name="cxarm"
LABEL org.opencontainers.image.source="https://iar.com"
LABEL org.opencontainers.image.vendor="IAR Systems AB"
LABEL org.opencontainers.image.version=${VERSION}

# Set PowerShell as default shell for RUN
SHELL ["powershell.exe", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Install Latest CMake
RUN `
    $latestCMake = Invoke-RestMethod -Uri "https://api.github.com/repos/kitware/cmake/releases/latest"; `
    $downloadURL = ($latestCMake.assets | Where-Object { $_.name -like 'cmake-*-windows-x86_64.zip' }).browser_download_url; `
    $fileName = ($latestCmake.assets | Where-Object { $_.name -like 'cmake-*-windows-x86_64.zip' }).name; `
    $baseDir = (Split-Path -Path "$fileName" -Leaf); `
    Invoke-WebRequest -Uri "$downloadURL" -OutFile "$fileName"; `
    mkdir 'C:\Tools\; `
    Expand-Archive -Path "$fileName" -DestinationPath "C:\Tools"; `
    Add-Content -Path 'C:\Tools\_path-cmake.txt' -NoNewLine -Value ("C:\"+$baseDir+"\bin")

# Install Latest Git
RUN `
    $latestGit4W = Invoke-RestMethod -Uri "https://api.github.com/repos/git-for-windows/git/releases/latest"; `
    $downloadURL = ($latestGit4W.assets | Where-Object { $_.name -like 'MinGit-*-busybox-64-bit.zip' }).browser_download_url; `
    $fileName = ($latestGit4W.assets | Where-Object { $_.name -like 'MinGit-*-busybox-64-bit.zip' }).name; `
    $baseDir = (Split-Path -Path "$fileName" -Leaf); `
    Invoke-WebRequest -Uri "$downloadURL" -OutFile "$fileName"; `
    Expand-Archive -Path "$fileName" -DestinationPath "C:\Tools\$baseDir"; `
    Add-Content -Path 'C:\Tools\_path-git.txt' -NoNewLine -Value ("C:\"+$baseDir+"\cmd")

# Install Latest Ninja
RUN `
    $latestNinja = Invoke-RestMethod -Uri "https://api.github.com/repos/ninja-build/ninja/releases/latest"; `
    $downloadURL = ($latestNinja.assets | Where-Object { $_.name -eq 'ninja-win.zip' }).browser_download_url; `
    $fileName = ($latestNinja.assets | Where-Object { $_.name -eq 'ninja-win.zip' }).name; `
    $baseDir = (Split-Path -Path "$fileName" -Leaf); `
    Invoke-WebRequest -Uri "$downloadURL" -OutFile "$fileName"; `
    Expand-Archive -Path "$fileName" -DestinationPath "C:\Tools\$baseDir"; `
    Add-Content -Path 'C:\Tools\_path-ninja.txt' -NoNewLine -Value ("C:\"+$baseDir)

# Install the IAR Build Tools
ADD https://github.com/iarsystems/arm/releases/download/${VERSION}/cxarm-${VERSION}-windows-x86_64-minimal.zip cxarm.zip
RUN `
    Expand-Archive "cxarm.zip" -DestinationPath "C:\Tools\iar"; `
    Add-Content -Path 'C:\Tools\_path-ibt.txt' -NoNewLine -Value "C:\iar\cxarm-${VERSION}\arm\bin;C:\iar\cxarm-${VERSION}\common\bin"

# Install the IAR LMSC Tools
RUN `
    $re = [regex]::new('href="(https://.*\.exe)"'); `
    $latestLMSC = $re.Match((Invoke-WebRequest "https://updates.iar.com/?product=LMSCDAEMON").Content).Groups[1].Value; `
    $fileName = (Split-Path -Path $latestLMSC -Leaf); `
    Invoke-WebRequest -Uri $latestLMSC -OutFile $fileName; `
    Start-Process -FilePath "$fileName" -ArgumentList "/VERYSILENT,"/SUPPRESSMSGBOXES","/DIR=C:/Tools/iar" -wait; `
    Add-Content -Path 'C:\Tools\_path-lmsc.txt' -NoNewLine -Value 'C:\iar\lmsc'



# Nanoserver offers a "lightweight" option for Windows container images
FROM mcr.microsoft.com/windows/nanoserver:ltsc${WINVER}

COPY --from=build ["C:/Tools", "C:/"]

# Set PATH from C:/_path.txt
RUN for /f %i in (C:\_path*.txt) do setx /M PATH "%PATH%;%i"

# Set the work directory
WORKDIR "C:/workdir"
